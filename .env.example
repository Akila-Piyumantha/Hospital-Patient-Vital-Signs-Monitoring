# Copy to .env to override defaults (`cp .env.example .env`). Every value below is the default,
# so the stack also runs with no .env at all.

# --- Simulated clock ---------------------------------------------------------------------
# 1 simulated day = SIM_DAY_SECONDS real seconds (300 = 5 minutes).
SIM_DAY_SECONDS=300
# Leave empty: the first service to start records the epoch in data/state/sim_epoch.
# (`make reset` deletes it so simulated time restarts at day 1.)
SIM_EPOCH=

# --- Cohort -------------------------------------------------------------------------------
SIM_SEED=42            # same seed => same patients, same story, same lab files
NUM_PATIENTS=20
NUM_DETERIORATING=4    # patients with a scripted deterioration episode (vitals AND labs go bad)
NUM_OCCULT=2           # patients with normal vitals but abnormal labs from day 2-3 (hidden risk)

# --- Vitals stream ------------------------------------------------------------------------
VITALS_INTERVAL_SECONDS=2
SPIKE_RATE=0.01        # chance per reading of a short abnormal spike
# Fault injection: off | low (default, ~2% rejected readings) | chaos (~16%, trips DlqRateHigh)
FAULT_PROFILE=low
# Fine-grained overrides (probability per reading), e.g.:
# FAULT_NULL_RATE=0.05
# FAULT_GARBAGE_RATE=0.05
# FAULT_DUPLICATE_RATE=0.05
# FAULT_LATE_RATE=0.10
# FAULT_DROPOUT_RATE=0.01

# --- Lab file faults (deterministic failure demos; comma-separated simulated days) ------------
# LAB_FORCE_MISSING_DAYS=4      # file never arrives   -> LabFileMissing alert
# LAB_FORCE_LATE_DAYS=3         # file arrives LAB_LATE_SECONDS late
# LAB_FORCE_CORRUPT_DAYS=5      # bad rows (N/A value, unknown patient, duplicate, ...)
# LAB_FORCE_BADSCHEMA_DAYS=6    # header lacks a column -> whole file must be quarantined
# LAB_MISSING_RATE=0            # or random rates per file
# LAB_LATE_RATE=0
# LAB_CORRUPT_RATE=0
LAB_LATE_SECONDS=90

# --- Kafka topics -------------------------------------------------------------------------
VITALS_TOPIC=vitals.raw
DLQ_TOPIC=vitals.dlq
VITALS_PARTITIONS=3

# --- Postgres / Grafana ---------------------------------------------------------------------
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_DB=hospital
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

LOG_LEVEL=INFO
