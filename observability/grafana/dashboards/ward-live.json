    {
      "id": 7,
      "type": "table",
      "title": "Patients by risk",
      "description": "Current status per patient (patient_status joined with the patients dimension).",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "hospital-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "hospital-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.patient_id, p.bed, s.risk_tier, s.news_score, s.lab_risk_points, s.trend_flag, s.heart_rate, s.spo2, s.systolic_bp, s.diastolic_bp, s.temperature, s.last_reading_at FROM patient_status s JOIN patients p USING (patient_id) ORDER BY CASE s.risk_tier WHEN 'CRITICAL' THEN 1 WHEN 'HIGH' THEN 2 WHEN 'MEDIUM' THEN 3 ELSE 4 END, s.news_score DESC, s.patient_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "risk_tier"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "LOW": {
                        "color": "green",
                        "index": 0
                      },
                      "MEDIUM": {
                        "color": "yellow",
                        "index": 1
                      },
                      "HIGH": {
                        "color": "orange",
                        "index": 2
                      },
                      "CRITICAL": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
