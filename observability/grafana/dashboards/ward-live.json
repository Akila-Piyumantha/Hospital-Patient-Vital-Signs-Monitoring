          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT window_end AS time, avg_heart_rate AS \"avg heart rate\", max_heart_rate AS \"max heart rate\" FROM vitals_window WHERE patient_id = '$patient' AND $__timeFilter(window_end) ORDER BY 1"
