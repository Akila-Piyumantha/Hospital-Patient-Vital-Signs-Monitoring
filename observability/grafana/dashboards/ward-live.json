{
  "uid": "ward-live",
  "title": "Ward Live Monitoring",
  "description": "Near-real-time patient risk, alerts and vitals (speed layer) plus the latest daily risk report (batch layer). Reads Postgres tables from contract 4.4.",
  "tags": [
    "hospital",
    "pipeline"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "patient",
        "label": "Patient",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "hospital-db"
        },
        "query": "SELECT patient_id FROM patients ORDER BY 1",
        "refresh": 1,
        "sort": 1,
        "current": {},
        "includeAll": false
      }
    ]
  },
